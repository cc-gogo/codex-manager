<Window x:Class="CodexConversationManager.App.Views.DeleteProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:CodexConversationManager.App.Markup"
        Title="永久删除进度" Width="500" Height="390" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Loc Key=DeleteProgress}" />
            <TextBlock Margin="0,6,0,12" Text="{Binding CompletedCount, StringFormat=已完成 {0} 条}" />
        </StackPanel>
        <ListBox Grid.Row="1" ItemsSource="{Binding Results}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Id}" />
                        <TextBlock Foreground="#9A6700" TextWrapping="Wrap" Text="{Binding Message}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Padding="14,7" Margin="0,0,8,0" Click="RestartCodex_Click" Content="重启 Codex" />
            <Button Padding="14,7" Click="Close_Click" Content="{loc:Loc Key=Close}" />
        </StackPanel>
    </Grid>
</Window>
