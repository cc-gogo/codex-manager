<Window x:Class="CodexConversationManager.App.Views.ProviderSyncDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:CodexConversationManager.App.Markup" Title="{loc:Loc Key=SyncLogin}" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <StackPanel Margin="22">
    <TextBlock FontSize="18" FontWeight="SemiBold" Text="{loc:Loc Key=ProviderSync}" />
    <TextBlock Margin="0,12,0,8" TextWrapping="Wrap" Foreground="#475467" Text="{loc:Loc Key=SyncDescription}" />
    <TextBlock Margin="0,4,0,14" TextWrapping="Wrap" Text="{Binding Status}" />
    <TextBlock Text="确认执行请输入：同步 provider" />
    <TextBox Margin="0,6,0,16" Padding="8" Text="{Binding Confirmation, UpdateSourceTrigger=PropertyChanged}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Padding="14,7" Margin="0,0,8,0" IsCancel="True" Content="{loc:Loc Key=Cancel}" />
      <Button Padding="14,7" Background="#1769AA" Foreground="White" IsEnabled="{Binding CanApply}" Click="Apply_Click" Content="{loc:Loc Key=StartSync}" />
    </StackPanel>
  </StackPanel>
</Window>
