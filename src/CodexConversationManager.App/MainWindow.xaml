<Window x:Class="CodexConversationManager.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodexConversationManager.App.ViewModels"
        xmlns:loc="clr-namespace:CodexConversationManager.App.Markup"
        Title="{loc:Loc Key=AppTitle}" Height="760" Width="1280" MinHeight="580" MinWidth="980"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
        </Style>
        <Style x:Key="LanguageSelector" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#D8DEE8" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E9EEF5" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NormalCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsNormalCategorySelected}" Value="True"><Setter Property="Background" Value="#DCEBFA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="SubAgentCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsSubAgentCategorySelected}" Value="True"><Setter Property="Background" Value="#DCEBFA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ResidualCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsResidualCategorySelected}" Value="True"><Setter Property="Background" Value="#DCEBFA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ArchivedCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsArchivedCategorySelected}" Value="True"><Setter Property="Background" Value="#DCEBFA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DamagedCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsDamagedCategorySelected}" Value="True"><Setter Property="Background" Value="#DCEBFA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="DuplicateCategoryButton" TargetType="Button" BasedOn="{StaticResource CategoryButton}">
            <Style.Triggers><DataTrigger Binding="{Binding IsDuplicateCategorySelected}" Value="True"><Setter Property="Background" Value="#DCEBFA" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ConversationItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="62" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#EDF3FA" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#DCEBFA" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SelectableReaderText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsUndoEnabled" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Background="#F7F8FA">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="20,16,20,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Margin="0,0,8,0" Click="Refresh_Click" Content="{loc:Loc Key=Refresh}" />
                <Button Margin="0,0,8,0" Click="ProviderSync_Click" Content="{loc:Loc Key=ProviderSync}"
                        ToolTip="{loc:Loc Key=ProviderTooltip}" />
                <Button Margin="0,0,8,0" Click="ExportMarkdown_Click" Content="{loc:Loc Key=ExportMarkdown}" />
                <Button Margin="0,0,8,0" Click="ImportConversation_Click" Content="{loc:Loc Key=ImportConversation}" />
                <Button Margin="0,0,8,0" Click="StopCodex_Click" Content="{loc:Loc Key=ExitCodex}" />
                <ComboBox x:Name="LanguageComboBox" Style="{StaticResource LanguageSelector}" Width="92" Margin="8,0,0,0" SelectionChanged="LanguageComboBox_SelectionChanged" SelectedIndex="0">
                    <ComboBoxItem Content="中文" Tag="Chinese" />
                    <ComboBoxItem Content="English" Tag="English" />
                </ComboBox>
            </StackPanel>
            <StackPanel>
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#162033" Text="{loc:Loc Key=AppTitle}" />
                <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="{loc:Loc Key=AppSubtitle}" />
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="20,0,20,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330" MinWidth="260" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" MinWidth="420" /><ColumnDefinition Width="245" MinWidth="220" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DCE1E8" BorderThickness="1" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="{loc:Loc Key=Categories}" Margin="4,3,4,6" />
                        <Button Style="{StaticResource NormalCategoryButton}" Content="{loc:Loc Key=Normal}" Tag="Normal" Click="Category_Click" />
                        <Button Style="{StaticResource SubAgentCategoryButton}" Content="{loc:Loc Key=SubAgent}" Tag="SubAgent" Click="Category_Click" />
                        <Button Style="{StaticResource ResidualCategoryButton}" Content="{loc:Loc Key=Residual}" Tag="Residual" Click="Category_Click" />
                        <Button Style="{StaticResource ArchivedCategoryButton}" Content="{loc:Loc Key=Archived}" Tag="Archived" Click="Category_Click" />
                        <Button Style="{StaticResource DamagedCategoryButton}" Content="{loc:Loc Key=Damaged}" Tag="Damaged" Click="Category_Click" />
                        <Button Style="{StaticResource DuplicateCategoryButton}" Content="{loc:Loc Key=Duplicate}" Tag="Duplicate" Click="Category_Click" />
                    </StackPanel>
                    <TextBox Grid.Row="1" Margin="3,12,3,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" BorderBrush="#D8DEE8" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock FontWeight="SemiBold" Foreground="#344054" Text="{loc:Loc Key=Projects}" Margin="4,0,4,7" />
                        <TreeView Grid.Row="1" ItemsSource="{Binding ProjectTree}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedItemChanged="ProjectTreeSelectionChanged">
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type local:ConversationTreeNodeViewModel}" ItemsSource="{Binding Children}">
                                    <Grid Margin="0,1" MinHeight="28">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ThreadCheck" Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Conversation.IsSelected, Mode=TwoWay}" Visibility="Collapsed" />
                                        <TextBlock x:Name="FolderName" Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Center" Padding="3,4" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="ThreadName" Grid.Column="1" VerticalAlignment="Center" Padding="0,4" Text="{Binding Conversation.SingleLineTitle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    </Grid>
                                    <HierarchicalDataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsConversation}" Value="True">
                                            <Setter TargetName="ThreadCheck" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="FolderName" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="ThreadName" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </HierarchicalDataTemplate.Triggers>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#E4E7EC" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" />
            <Border Grid.Column="2" Background="White" BorderBrush="#DCE1E8" BorderThickness="0,1,0,1">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Padding="20,15" BorderBrush="#E4E7EC" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBox Style="{StaticResource SelectableReaderText}" Height="25" MaxHeight="25" FontSize="17" FontWeight="SemiBold" Foreground="#1D2939" Text="{Binding SelectedRow.SingleLineTitle, Mode=OneWay}" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Hidden" />
                            <TextBox Style="{StaticResource SelectableReaderText}" Margin="0,4,0,0" FontFamily="Consolas" FontSize="11" Foreground="#98A2B3" Text="{Binding SelectedRow.Id, Mode=OneWay}" />
                            <TextBox Style="{StaticResource SelectableReaderText}" Margin="0,4,0,0" FontSize="11" Foreground="#667085" TextWrapping="Wrap" Text="{Binding SelectedRow.SourceSummary, Mode=OneWay}" />
                            <TextBox Style="{StaticResource SelectableReaderText}" Margin="0,7,0,0" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="原始文件 / 索引来源路径" />
                            <TextBox Style="{StaticResource SelectableReaderText}" Margin="0,2,0,0" FontFamily="Consolas" FontSize="10" Foreground="#667085" TextWrapping="Wrap" Text="{Binding SelectedRow.OriginalFilePathSummary, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" Padding="28,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBox Style="{StaticResource SelectableReaderText}" Margin="0,0,0,16" Foreground="#667085" Text="{Binding DetailStatus, Mode=OneWay}" />
                            <ItemsControl ItemsSource="{Binding DetailBlocks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,20">
                                            <TextBox Style="{StaticResource SelectableReaderText}" FontSize="12" FontWeight="SemiBold" Foreground="#667085" Text="{Binding Role, Mode=OneWay}" />
                                            <Border Margin="0,5,0,0" Background="#F8FAFC" BorderBrush="#EAECF0" BorderThickness="1" Padding="14,11">
                                                <TextBox Style="{StaticResource SelectableReaderText}" Foreground="#1D2939" TextWrapping="Wrap" Text="{Binding Text, Mode=OneWay}" />
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
            <Border Grid.Column="3" Background="White" BorderBrush="#DCE1E8" BorderThickness="1" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#344054" Text="{loc:Loc Key=PermanentDelete}" />
                        <TextBlock Margin="0,8,0,12" Foreground="#9B6500" TextWrapping="Wrap" Text="{Binding DeletionStatus}" />
                        <Button Margin="0,0,0,8" Background="#F2F4F7" BorderBrush="#667085" Foreground="#101828" Padding="10,9" Click="RestartCodex_Click" Content="{loc:Loc Key=RestartCodex}" />
                        <GroupBox Header="{loc:Loc Key=Backup}" Margin="0,8,0,0" Padding="8">
                            <StackPanel>
                                <Button Margin="0,0,0,7" Padding="8,7" Click="ManualBackup_Click" Content="{loc:Loc Key=ManualBackup}" />
                                <Button Margin="0,0,0,7" Padding="8,7" Click="ChooseAutoBackup_Click" Content="{loc:Loc Key=AutoBackup}" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock VerticalAlignment="Center" Text="{loc:Loc Key=AutoBackupInterval}" />
                                    <ComboBox x:Name="AutoBackupIntervalComboBox" Width="90" SelectedIndex="1">
                                        <ComboBoxItem Tag="15" Content="15 分钟" />
                                        <ComboBoxItem Tag="30" Content="30 分钟" />
                                        <ComboBoxItem Tag="60" Content="60 分钟" />
                                    </ComboBox>
                                </StackPanel>
                                <Button Padding="8,6" Click="StopAutoBackup_Click" Content="{loc:Loc Key=StopAutoBackup}" />
                                <TextBlock x:Name="AutoBackupStatus" Margin="0,7,0,0" FontSize="11" Foreground="#667085" Text="{loc:Loc Key=AutoBackupOff}" TextWrapping="Wrap" />
                            </StackPanel>
                        </GroupBox>
                        <Button Margin="0,0,0,8" IsEnabled="{Binding CanSelectVisibleRows}" Background="#F2F4F7" BorderBrush="#667085" Foreground="#101828" Padding="10,9" Click="SelectVisible_Click">
                            <TextBlock Text="{Binding SelectVisibleButtonText}" />
                        </Button>
                        <Button IsEnabled="{Binding CanStartDeletion}" Background="#F2F4F7" BorderBrush="#667085" Foreground="#101828" FontWeight="SemiBold" Padding="10,9" Click="Delete_Click">
                            <TextBlock Text="{Binding DeleteButtonText}" />
                        </Button>
                        <Expander Margin="0,18,0,0" Header="{loc:Loc Key=Diagnostics}">
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding RefreshDiagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,7">
                                            <TextBlock FontSize="12" Foreground="#475467" Text="{Binding Source}" />
                                            <TextBlock FontSize="11" Foreground="#667085" Text="{Binding StatusText}" />
                                            <TextBlock FontSize="11" Foreground="#667085" Text="{Binding RecordCount, StringFormat=记录：{0}}" />
                                            <TextBlock FontSize="11" Foreground="#B42318" TextWrapping="Wrap" Text="{Binding Error}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#EAF2FF" Padding="20,8"><TextBlock Foreground="#285A9B" Text="{loc:Loc Key=Footer}" /></Border>
    </Grid>
</Window>
